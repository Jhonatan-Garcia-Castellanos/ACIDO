# ============================================================
# .env.example — PLANTILLA para el equipo (SÍ se sube a git)
# Copia como ".env" y completa tus valores reales:
#   copy .env.example .env   (Windows)
# ============================================================

# === BASE DE DATOS ===
DB_HOST=localhost
DB_PORT=3307
DB_NAME=proyecto_acido
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# === SMTP (Mailtrap: Email Testing → Inboxes → SMTP Settings → PHPMailer) ===
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=TU_MAILTRAP_USERNAME
MAIL_PASSWORD=TU_MAILTRAP_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM=no-reply@acido.local
MAIL_FROM_NAME="ACIDO Colombia"

# === APP ===
APP_URL=http://localhost/ACIDO/BACKPHP_TEST

# === SESIÓN (lista 1.3: 15 min inactividad) ===
# Producción/revisión: 900. Para demo rápida del revisor: cambia a 60, prueba, y vuelve a 900.
SESSION_TIMEOUT=900
